// Explicit recording clock/native RAW boundary, not registry/selection logic.
inline core::RepairMonotonicBirth serving_repair_clock_now(uint64_t domain){return {domain,uint64_t(Clock::ticks.count())*1000000};}
struct ServingRawSession {
    enum class Phase{running,drained};
    uint64_t occupancy=0;struct Cut{uint64_t id=1;} state;
    struct Key{uint64_t window_generation=9;} identity;
    bool healthy()const{return true;}bool request_open()const{return true;}
    Phase phase()const{return Phase::running;}
    uint64_t slot_occupancy_incarnation()const{return occupancy;}
    const Cut&cut()const{return state;}const Key&key()const{return identity;}
};
struct RecordingRepair{struct{struct{uint64_t id=0;}cut;}published;};
// Private repair is outside this focused foreground reproduction: fail closed
// if an unexpected path reaches it, never provide a fabricated repair receipt.
struct ServingSuffixRepairOperation {
    struct Age{RepairAgeInputs age;bool valid=false;uint64_t ancestry_serial=0;};
    struct Evidence{ServingRawSession::Cut private_cut()const{core::retirement_failed("unsupported repair evidence");}};
    static Age repair_age(const RecordingRepair&,core::RepairMonotonicBirth){core::retirement_failed("unsupported repair age");}
    static bool private_cache_restored(const RecordingRepair&){core::retirement_failed("unsupported repair cache");}
    static bool repair_unit(RecordingRepair&,bool,std::string&,uint64_t){core::retirement_failed("unsupported private repair");}
    static Evidence owner_evidence(const RecordingRepair&){core::retirement_failed("unsupported repair receipt");}
};
