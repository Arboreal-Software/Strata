struct SelectionTrace {std::vector<program::ServingThreadUnit> units;program::ServingThreadSelection selected;uint64_t ticket;};
struct Probe {
    program::ServingThreadBridge& real;std::vector<SelectionTrace> selections;
    auto binding(size_t n)const{return real.binding(n);}
    auto operation(const core::OperationKey& k)const{return real.operation(k);}
    bool cancellation_pending(size_t n)const{return real.cancellation_pending(n);}
    bool request_ready(size_t n,uint64_t r)const{return real.request_ready(n,r);}
    uint64_t engine()const{return real.engine();}
    auto select(const program::ServingRepairAdmissionPolicy& p,const program::ServingRepairSelectionBoundary& b,
                std::span<const program::ServingThreadUnit> units,uint64_t now,uint64_t ticket){
        auto result=real.select(p,b,units,now,ticket);
        selections.push_back({std::vector<program::ServingThreadUnit>(units.begin(),units.end()),result,ticket});
        std::printf("TRACE select supplied=%zu ticket=%llu total=%llu selected=%zu ready=%d priority=%lld units=",
            units.size(),(unsigned long long)ticket,(unsigned long long)result.total_weight,result.candidate,int(result.ready),(long long)result.effective_priority);
        for(const auto& u:units)std::printf("[%zu,%s,occupancy=%llu]",u.slot,u.unit==core::AdmissionUnit::prefill?"prefill":"decode",(unsigned long long)u.occupancy);
        std::puts("");return result;
    }
    auto foreground_peer(const program::ServingThreadSelection& w,const program::ServingThreadUnit& u)const{return real.foreground_peer(w,u);}
    bool acknowledge_unit(const program::ServingThreadSelection& w,const program::ServingThreadUnit& u,uint64_t occ,uint64_t cut){return real.acknowledge_unit(w,u,occ,cut);}
};
